{
  "name": "@svgph/deepclaw",
  "version": "2.2.0",
  "description": "Enterprise-Governance-First Open Source AI Agent Framework",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.mjs",
      "require": "./dist/server.cjs",
      "types": "./dist/server.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.mjs",
      "types": "./dist/cli.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "deepclaw": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "llm",
    "agent",
    "ai-agent",
    "agentic-ai",
    "ai-security",
    "ai-governance",
    "zero-trust",
    "policy-engine",
    "rbac",
    "sandbox",
    "audit-logger",
    "sso",
    "vulnerability-scanner",
    "mcp",
    "model-context-protocol",
    "a2a",
    "agent-to-agent",
    "evals",
    "workflow",
    "orchestration",
    "multi-tenant",
    "memory",
    "vector-search",
    "token-optimization",
    "dlp",
    "secret-redaction",
    "budget-guard",
    "channels",
    "slack",
    "telegram",
    "discord",
    "whatsapp",
    "teams",
    "email",
    "sms",
    "webhook",
    "governance",
    "compliance",
    "iso-42001",
    "soc2",
    "siem",
    "deepclaw",
    "svgph",
    "siliconvalleyglobal"
  ],
  "author": "SILICON VALLEY GLOBAL PH INC <opensource@svg.ph>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/siliconvalleyglobal/DeepCLAW.git"
  },
  "homepage": "https://svg.ph",
  "bugs": {
    "url": "https://github.com/siliconvalleyglobal/DeepCLAW/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/siliconvalleyglobal"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.mjs",
    "test": "vitest run",
    "lint": "oxlint --type-aware src/ tests/",
    "format": "oxfmt --check src/ tests/",
    "format:fix": "oxfmt --write src/ tests/",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm test",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.14",
    "tsx": "^4.19.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "5.3.4",
      "@sinclair/typebox": "0.34.48"
    }
  }
}
