{
  "name": "@deepclaw/ui",
  "version": "2.0.0",
  "description": "DeepCLAW governance dashboard (Lit + Vite)",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint --type-aware src/",
    "format": "oxfmt --check src/",
    "format:fix": "oxfmt --write src/",
    "typecheck": "tsgo --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "lit": "^3.3.3",
    "marked": "^17.0.1",
    "dompurify": "^3.3.1"
  },
  "devDependencies": {
    "vite": "^8.2.1",
    "typescript": "^7.0.2",
    "oxlint": "^1.77.0",
    "oxfmt": "^0.62.0"
  }
}
