{
  "name": "@deepclaw/gateway",
  "version": "2.0.1",
  "description": "DeepCLAW gateway proxy with policy enforcement",
  "type": "module",
  "main": "./dist/cli.js",
  "module": "./dist/cli.mjs",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.cjs",
      "types": "./dist/cli.d.ts"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/server.mjs",
    "lint": "oxlint --type-aware src/",
    "format": "oxfmt --check src/",
    "format:fix": "oxfmt --write src/",
    "typecheck": "tsgo --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@deepclaw/core": "workspace:*",
    "@deepclaw/sdk": "workspace:*",
    "hono": "^4.13.0",
    "ws": "^8.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
