{
  "name": "@deepclaw/core",
  "version": "2.0.1",
  "description": "DeepCLAW core types and interfaces",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint --type-aware src/",
    "format": "oxfmt --check src/",
    "format:fix": "oxfmt --write src/",
    "typecheck": "tsgo --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "tsdown": "^0.22.14",
    "oxlint": "^1.77.0",
    "oxfmt": "^0.62.0"
  }
}
