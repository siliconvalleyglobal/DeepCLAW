{
  "aiModels": {
    "simple": "claude-haiku-4-5",
    "medium": "claude-sonnet-4-6",
    "complex": "claude-opus-4-6"
  },
  "context": {
    "maxTokens": 8000,
    "ignorePatterns": [
      "*.test.ts",
      "dist/*",
      ".env*",
      ".git/*",
      "node_modules/*"
    ]
  },
  "memory": {
    "autoUpdate": true,
    "schemaVersion": 1
  },
  "cache": {
    "enabled": true,
    "provider": "anthropic"
  },
  "compression": {
    "aggressivePrune": true,
    "removeComments": true,
    "minifyJson": true
  },
  "eval": {
    "gateOnRegression": true,
    "minSuccessRate": 0.9
  }
}